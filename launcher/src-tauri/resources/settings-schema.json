    {
      "key": "mouse_gyro",
      "section": "mouse",
      "ini_section": "input",
      "type": "enum",
      "default": "auto",
      "options": [
        "auto",
        "0",
        "1"
      ],
      "label": {
        "fr": "Souris comme gyroscope",
        "en": "Mouse as gyro",
        "es": "Ratón como giroscopio",
        "ja": "マウスをジャイロとして使用"
      },
      "help": {
        "fr": "auto : actif pour ce jeu (la souris vise comme le gyroscope de la manette), 1 force, 0 coupe (la souris devient le stick droit). Les commandes de mouvement doivent être activées dans les options du jeu.",
        "en": "auto: on for this game (the mouse aims like the pad's gyro), 1 forces it, 0 turns it off (the mouse is a right stick). Motion controls must be on in the game's options.",
        "es": "auto: activo para este juego (el ratón apunta como el giroscopio del mando), 1 lo fuerza, 0 lo desactiva (el ratón es el stick derecho). Los controles de movimiento deben estar activados en las opciones del juego.",
        "ja": "auto：このゲームではオン（マウスがコントローラーのジャイロのように照準します）、1で強制オン、0でオフ（マウスは右スティックになります）。ゲームのオプションでモーションコントロールを有効にしておく必要があります。"
      }
    },
    {
      "key": "mouse_gyro_sens",
      "section": "mouse",
      "ini_section": "input",
      "type": "float",
      "default": "0.04",
      "min": 0.002,
      "max": 1,
      "slider": true,
      "step": 0.002,
      "label": {
        "fr": "Sensibilité de visée (degrés par pas)",
        "en": "Aim sensitivity (degrees per count)",
        "es": "Sensibilidad de puntería (grados por paso)",
        "ja": "照準感度（1カウントあたりの角度）"
      },
      "help": {
        "fr": "Degrés dont la manette virtuelle tourne par pas de souris (0,002 à 1). 0,04 fait environ un tour de caméra pour 11,9 cm à 800 DPI. La sensibilité des options du jeu s'y multiplie.",
        "en": "Degrees the virtual controller turns per mouse count (0.002 to 1). 0.04 is about one camera turn per 11.9 cm at 800 DPI. The game's own camera sensitivity multiplies it.",
        "es": "Grados que gira el mando virtual por cada paso del ratón (de 0,002 a 1). 0,04 equivale a una vuelta de cámara cada 11,9 cm a 800 DPI. La sensibilidad de las opciones del juego se multiplica por este valor.",
        "ja": "マウス1カウントごとに仮想コントローラーが回る角度です（0.002～1）。0.04は800 DPIでマウスを約11.9 cm動かすとカメラが1周する値です。ゲーム側のカメラ感度はこの値に掛け合わされます。"
      }
    },
    {
      "key": "mouse_gyro_cm360",
      "section": "mouse",
      "ini_section": "input",
      "type": "float",
      "default": "0",
      "min": 0,
      "max": 200,
      "label": {
        "fr": "Centimètres pour un tour complet",
        "en": "Centimetres per full turn",
        "es": "Centímetros por vuelta completa",
        "ja": "1周あたりのセンチメートル"
      },
      "help": {
        "fr": "Distance de souris pour un tour complet de caméra, au DPI choisi (0 à 200). Au-dessus de 0, remplace la sensibilité en degrés par pas.",
        "en": "Mouse travel for a full camera turn at the chosen DPI (0 to 200). Above 0, replaces the degrees-per-count sensitivity.",
        "es": "Recorrido del ratón para una vuelta completa de cámara con los DPI elegidos (de 0 a 200). Si es mayor que 0, sustituye la sensibilidad en grados por paso.",
        "ja": "選んだDPIで、カメラを1周させるためのマウスの移動距離です（0～200）。0より大きいと、1カウントあたりの角度による感度の代わりに使われます。"
      }
    },
