    {
      "key": "vk_present",
      "section": "display",
      "ini_section": "display",
      "type": "enum",
      "default": "mailbox",
      "options": [
        "mailbox",
        "fifo",
        "immediate"
      ],
      "label": {
        "fr": "Mode de présentation",
        "en": "Presentation mode",
        "es": "Modo de presentación",
        "ja": "表示モード"
      },
      "help": {
        "fr": "mailbox (défaut), fifo (V-sync) ou immediate (sans V-sync, déchirures possibles).",
        "en": "mailbox (default), fifo (vsync) or immediate (no vsync, tearing).",
        "es": "mailbox (predeterminado), fifo (V-sync) o immediate (sin V-sync, puede haber desgarros).",
        "ja": "mailbox（既定）、fifo（V-sync）、immediate（V-syncなし、ティアリングが出ることがあります）。"
      }
    },
    {
      "key": "upscaler",
      "section": "display",
      "ini_section": "display",
      "type": "enum",
      "default": "fsr",
      "options": [
        "fsr4",
        "fsr3",
        "fsr",
        "dlss",
        "dlaa",
        "bilinear"
      ],
      "label": {
        "fr": "Mise à l'échelle",
        "en": "Upscaler",
        "es": "Escalado",
        "ja": "アップスケーラー"
      },
      "help": {
        "fr": "fsr4 : FSR 4.1 (temporel, le plus net ; nécessite le runtime AMD FidelityFX à côté de l'exécutable). fsr3 : FSR 3.1. fsr : FSR 1 (spatial). dlss/dlaa : NVIDIA. bilinear : simple. Utilisée quand la fenêtre est plus grande que la résolution du jeu.",
        "en": "fsr4: FSR 4.1 (temporal, the sharpest; needs the AMD FidelityFX runtime next to the executable). fsr3: FSR 3.1. fsr: FSR 1 (spatial). dlss/dlaa: NVIDIA. bilinear: plain. Used when the window is larger than the game resolution.",
        "es": "fsr4: FSR 4.1 (temporal, el más nítido; requiere el runtime AMD FidelityFX junto al ejecutable). fsr3: FSR 3.1. fsr: FSR 1 (espacial). dlss/dlaa: NVIDIA. bilinear: simple. Se usa cuando la ventana es mayor que la resolución del juego.",
        "ja": "fsr4: FSR 4.1（時間方向、最もシャープ。実行ファイルの隣に AMD FidelityFX ランタイムが必要）。fsr3: FSR 3.1。fsr: FSR 1（空間）。dlss/dlaa: NVIDIA。bilinear: 単純拡大。ウィンドウがゲームの解像度より大きいときに使われます。"
      }
    },
    {
      "key": "sharpness",
      "section": "display",
      "ini_section": "display",
      "type": "int",
      "default": "80",
      "min": 0,
      "max": 100,
      "label": {
        "fr": "Netteté FSR",
        "en": "FSR sharpness",
        "es": "Nitidez de FSR",
        "ja": "FSRのシャープネス"
      },
      "help": {
        "fr": "0 (désactivée) à 100.",
        "en": "0 (off) to 100.",
        "es": "De 0 (desactivada) a 100.",
        "ja": "0（オフ）～100。"
      }
    },
    {
      "key": "aspect",
