    {
      "key": "render_scale",
      "section": "display",
      "ini_section": "display",
      "type": "choice_int",
      "default": "game",
      "options": [
        "game"
      ],
      "min": 25,
      "max": 400,
      "label": {
        "fr": "Échelle de rendu 3D (%)",
        "en": "3D render scale (%)",
        "es": "Escala de renderizado 3D (%)",
        "ja": "3D描画スケール（%）"
      },
      "help": {
        "fr": "« game » ou un pourcentage de 25 à 400. Lue au démarrage.",
        "en": "'game' or a percentage from 25 to 400. Read at start.",
        "es": "«game» o un porcentaje de 25 a 400. Se lee al iniciar.",
        "ja": "「game」または25～400のパーセント値です。起動時に読み込まれます。"
      }
