    {
      "key": "mouse_mode",
      "section": "mouse",
      "ini_section": "input",
      "type": "enum",
      "default": "direct",
      "options": [
        "direct",
        "stick"
      ],
      "label": {
        "fr": "Mode de la souris",
        "en": "Mouse camera mode",
        "es": "Modo de cámara con el ratón",
        "ja": "マウスのカメラモード"
      },
      "help": {
        "fr": "direct : rotation brute de la caméra ; stick : la souris fait office de stick droit.",
        "en": "direct: raw camera turn; stick: the mouse acts as a right stick.",
        "es": "direct: giro directo de la cámara; stick: el ratón actúa como el stick derecho.",
        "ja": "direct：カメラを直接回転します。stick：マウスを右スティックとして扱います。"
      }
    },
    {
      "key": "mouse_sens",
      "section": "mouse",
      "ini_section": "input",
      "type": "float",
      "default": "1",
      "min": 0,
      "max": 10,
      "slider": true,
      "step": 0.1,
      "label": {
        "fr": "Sensibilité de la souris",
        "en": "Mouse sensitivity",
        "es": "Sensibilidad del ratón",
        "ja": "マウス感度"
      },
      "help": {
        "fr": "0 à 10 ; 0 désactive la caméra à la souris.",
        "en": "0 to 10; 0 turns the mouse camera off.",
        "es": "De 0 a 10; 0 desactiva la cámara con el ratón.",
        "ja": "0～10。0にするとマウスでのカメラ操作がオフになります。"
      }
    },
